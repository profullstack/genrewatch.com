{
  "name": "genrewatch.com",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "A release calendar for every genre. Follow a genre or a name, get told before it drops.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --hot apps/web/src/main.js",
    "start": "bun apps/web/src/main.js",
    "worker": "bun apps/worker/src/main.js",
    "migrate": "bun packages/db/src/migrate-cli.js",
    "sync": "bun apps/worker/src/sync-cli.js",
    "test": "bun test",
    "lint": "bun run --bun biome check .",
    "format": "bun run --bun biome format --write .",
    "imdb": "bun apps/worker/src/imdb-cli.js"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@electric-sql/pglite": "^0.5.5"
  }
}
