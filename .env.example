# Nothing here is required to boot. Each block switches on a feature.
NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000
ROLES=web,worker

DATABASE_URL=postgres://tipoff:tipoff@localhost:5432/tipoff
REDIS_URL=redis://localhost:6379

# Fixtures. ESPN needs no key.
SPORTS_PROVIDERS=espn
SPORTS_HORIZON_DAYS=14

# Web push. Generate with: bunx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@genrewatch.com

# Email
RESEND_API_KEY=
MAIL_FROM=GenreWatch <alerts@genrewatch.com>

# Paid streams. Must be a MERCHANT key (cp_live_/cp_test_ + 32 hex);
# an OAuth client id (cp_ + 24 hex) authenticates but cannot take money.
COINPAY_API_KEY=
COINPAY_BUSINESS_ID=
COINPAY_WEBHOOK_SECRET=

REMINDER_OFFSETS=60,1

# Sweep fixtures on the next boot regardless of how recently one ran. For shipping
# code that reads a new provider field: on, deploy, off. Left on it sweeps once per
# boot, which is ~354 upstream requests.
SYNC_ON_BOOT=false
SYNC_STALE_HOURS=6

# How far back a finished game is still owed the one read that closes out its play
# log. Bounds cost, not correctness: each summary is ~500KB through the metered
# proxy. Widen to backfill history (168 = a week) and put it back afterwards; the
# poller still reads 8 per tick, so reckon ~4 fixtures a minute.
SPORTS_PLAYS_CATCHUP_HOURS=12

# How far BACK the fixture sweep asks for, in days. The sweep looks forward, so by
# default nothing older than six hours is ever stored -- which is why widening
# SPORTS_PLAYS_CATCHUP_HOURS alone backfills nothing: it ranks stored fixtures, and
# a game that was never fetched was never stored. Set this to reach back for the
# fixtures (14 = a fortnight), let one sweep run, then put it back. Widen the
# catch-up window too, or the fixtures land with no play log.
SPORTS_BACKFILL_DAYS=0
